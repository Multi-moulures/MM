---
import Inner from '../components/Inner.astro';
import { site } from '../data/site';
import { getCategories, getProducts, productUrl, routes, type Lang } from '../i18n';
import { prix, sizesFor, dimsOf } from '../data/prix';
import { calibres, finis } from '../data/tarifs';
const { lang, role } = Astro.props as { lang: Lang; role: 'hub' | 'roofer' | 'dealer' };
const fr = lang === 'fr';
const products = getProducts(lang), categories = getCategories(lang);
const soon = fr ? 'À venir' : 'Coming soon';
const T = fr ? {
  hub: { h1: 'Accès pro', lead: 'Espace réservé aux couvreurs et aux marchands approuvés par Multi-Ventilation.' },
  roofer: { h1: 'Espace couvreurs', lead: 'Vos prix pour chaque produit de ventilation, en format standard ou sur mesure.' },
  dealer: { h1: 'Espace marchands', lead: 'PDSF, votre coût et votre marge, et des soumissions client en quelques clics.' },
  banner: 'Les prix seront affichés ici d’ici deux semaines. D’ici là, demandez un prix pour chaque produit et nous vous répondrons le jour même.',
  cRoof: 'Je suis couvreur', cRoofD: 'Votre prix par produit, grandeur, calibre et fini.',
  cDeal: 'Je suis marchand', cDealD: 'PDSF, votre coût, votre marge et vos soumissions client.',
  access: 'Pas encore d’accès ? Écrivez à', prod: 'Produit', msrp: 'PDSF', cost: 'Votre coût', margin: 'Marge', ask: 'Demander un prix', logout: 'Se déconnecter', title: 'Accès pro | Multi-Ventilation',
} : {
  hub: { h1: 'Pro access', lead: 'Reserved for roofers and dealers approved by Multi-Ventilation.' },
  roofer: { h1: 'Roofer area', lead: 'Your price for every ventilation product, in standard or custom sizes.' },
  dealer: { h1: 'Dealer area', lead: 'MSRP, your cost and your margin, and customer quotes in a few clicks.' },
  banner: 'Prices will be shown here within two weeks. Until then, request a price for any product and we will reply the same day.',
  cRoof: 'I am a roofer', cRoofD: 'Your price by product, size, gauge and finish.',
  cDeal: 'I am a dealer', cDealD: 'MSRP, your cost, your margin and customer quotes.',
  access: 'No access yet? Email', prod: 'Product', msrp: 'MSRP', cost: 'Your cost', margin: 'Margin', ask: 'Request a price', logout: 'Sign out', title: 'Pro access | Multi-Ventilation',
};
const C = fr
  ? { size: 'Grandeur', other: 'Autre format (sur mesure)', dimA: 'Dimension A (po)', dimB: 'Dimension B (po)', gauge: 'Calibre', finish: 'Fini', qty: 'Quantité', unit: 'Prix unitaire', total: 'Total avant taxes', custom: 'Sur soumission', billed: 'Facturé au format standard', tooBig: 'Format hors grille : sur soumission.', fiche: 'Voir la fiche technique', note: 'Prix en dollars canadiens, avant taxes et livraison. Les formats sur mesure sont facturés au format standard supérieur, ajusté selon le calibre et le fini.' }
  : { size: 'Size', other: 'Other size (custom)', dimA: 'Dimension A (in.)', dimB: 'Dimension B (in.)', gauge: 'Gauge', finish: 'Finish', qty: 'Quantity', unit: 'Unit price', total: 'Total before tax', custom: 'Quoted on request', billed: 'Billed at standard size', tooBig: 'Size beyond the price list: quoted on request.', fiche: 'View the spec sheet', note: 'Prices in Canadian dollars, before tax and delivery. Custom sizes are billed at the next standard size up, adjusted for gauge and finish.' };
const D = fr
  ? { h: 'Soumission client', lead: 'Ajoutez des produits et inscrivez votre prix de vente : le rabais par rapport au PDSF s’affiche pour votre client. Votre coût et votre marge ne sont jamais imprimés.', you: 'Votre entreprise', from: 'Soumission de', client: 'Client', date: 'Date', add: 'Ajouter un produit', sell: 'Votre prix', sellP: 'Prix', disc: 'Rabais', line: 'Total', del: 'Retirer', tPdsf: 'Total au PDSF', tDisc: 'Rabais total', tClient: 'Total client avant taxes', internal: 'Interne, non imprimé', tCost: 'Votre coût total', tMargin: 'Votre marge', below: 'Prix sous votre coût.', print: 'Imprimer ou enregistrer en PDF', grid: 'Grille de prix (format standard, fini standard)', valid: 'Prix valides 30 jours. Taxes et livraison en sus.' }
  : { h: 'Customer quote', lead: 'Add products and enter your selling price: the discount from MSRP is shown to your customer. Your cost and margin are never printed.', you: 'Your company', from: 'Quote from', client: 'Customer', date: 'Date', add: 'Add a product', sell: 'Your price', sellP: 'Price', disc: 'Discount', line: 'Total', del: 'Remove', tPdsf: 'Total at MSRP', tDisc: 'Total discount', tClient: 'Customer total before tax', internal: 'Internal, not printed', tCost: 'Your total cost', tMargin: 'Your margin', below: 'Price below your cost.', print: 'Print or save as PDF', grid: 'Price list (standard size, standard finish)', valid: 'Prices valid 30 days. Taxes and delivery extra.' };

const money = (n?: number) => n == null ? soon : n.toLocaleString(fr ? 'fr-CA' : 'en-CA', { style: 'currency', currency: 'CAD' });
// Données pour le configurateur (côté client).
const items = products.map((p) => {
  const all = sizesFor(p.slug, lang);
  const frLabels = sizesFor(p.slug, 'fr');
  const std = all.map((z, i) => ({ z, d: dimsOf(frLabels[i].label) })).filter((x) => !x.z.custom);
  const sizes = std.map(({ z, d }) => ({ label: z.label, dims: d.dims, ga: d.ga, c: prix[z.key]?.couvreur ?? null, p: prix[z.key]?.pdsf ?? null, k: prix[z.key]?.cout ?? null }));
  const customOk = sizes.length > 0 && sizes.every((s) => s.dims.length === 2) && std.every((x) => x.d.unit === 'po');
  return { slug: p.slug, name: p.name, url: productUrl(p.slug, lang), gauge: sizes.some((s) => s.ga != null), customOk, quoteOnly: sizes.length === 0, sizes };
});
const cfg = { gauges: calibres, finishes: finis.map((f) => ({ id: f.id, label: f[lang], m: f.m })) };
const L = { unit: fr ? 'po' : 'in.', soon, custom: C.custom, billed: C.billed, tooBig: C.tooBig, other: C.other, below: D.below, del: D.del, locale: fr ? 'fr-CA' : 'en-CA', quote: routes.quote[lang] };
const crumbs: [string, string][] = role === 'hub' ? [] : [[T.hub.h1, routes.pro[lang]]];
const prodOptions = categories.map((c) => ({ label: c.name, list: products.filter((p) => p.cat === c.id) }));
---
<Inner noindex title={T.title} description={T[role].lead} kicker={role === 'hub' ? 'Multi-Ventilation' : T.hub.h1} h1={T[role].h1} lead={T[role].lead} crumbs={crumbs}>
  {role === 'hub' && (
    <>
      <div class="grid g2 roles">
        <a class="card role" href={routes.proRoofers[lang]}><h2>{T.cRoof}</h2><p>{T.cRoofD}</p><span>→</span></a>
        <a class="card role" href={routes.proDealers[lang]}><h2>{T.cDeal}</h2><p>{T.cDealD}</p><span>→</span></a>
      </div>
      <p class="mn">{T.access} <a href={'mailto:' + site.email}>{site.email}</a>.</p>
    </>
  )}
  {role !== 'hub' && (
    <div id="pro" data-items={JSON.stringify(items)} data-cfg={JSON.stringify(cfg)} data-l={JSON.stringify(L)} data-role={role}>
      <p class="banner noprint">{T.banner}</p>
      <select class="tplsel" hidden>{prodOptions.map((g) => <optgroup label={g.label}>{g.list.map((p) => <option value={p.slug}>{p.name}</option>)}</optgroup>)}</select>
      <div class="tpllab" hidden data-prod={T.prod} data-size={C.size} data-a={C.dimA} data-b={C.dimB} data-gauge={C.gauge} data-finish={C.finish}></div>

      {role === 'roofer' && (
        <section class="calc">
          <div class="cfg" data-cfg-slot></div>
          <label class="qty">{C.qty}<input name="q" type="number" min="1" value="1" inputmode="numeric" /></label>
          <p class="mn" data-o="billed"></p>
          <div class="out">
            <div><span>{C.unit}</span><strong data-o="unit">{soon}</strong></div>
            <div><span>{C.total}</span><strong data-o="total">{soon}</strong></div>
          </div>
          <p class="btns"><a class="btn" data-o="ask" href={routes.quote[lang]}>{T.ask}</a><a class="btn ghost" data-o="fiche" href="#" target="_blank" rel="noopener">{C.fiche}</a></p>
          <p class="mn">{C.note}</p>
        </section>
      )}

      {role === 'dealer' && (
        <>
          <section class="dq">
            <h2>{D.h}</h2>
            <p class="mn noprint">{D.lead}</p>
            <div class="qhead">
              <label><span class="noprint">{D.you}</span><span class="onlyprint">{D.from}</span><input name="you" /></label>
              <label>{D.client}<input name="client" /></label>
              <label>{D.date}<input name="date" type="date" /></label>
            </div>
            <div class="lines"></div>
            <p class="noprint"><button type="button" class="btn ghost sm" data-a="add">+ {D.add}</button></p>
            <div class="sum">
              <div><span>{D.tPdsf}</span><strong data-o="pdsf">0</strong></div>
              <div><span>{D.tDisc}</span><strong data-o="disc">0</strong></div>
              <div><span>{D.tClient}</span><strong data-o="client">0</strong></div>
            </div>
            <div class="internal noprint"><p class="caps">{D.internal}</p>
              <div class="sum"><div><span>{D.tCost}</span><strong data-o="cost">0</strong></div><div><span>{D.tMargin}</span><strong data-o="margin">0</strong></div></div>
            </div>
            <p class="mn">{D.valid}</p>
            <p class="btns noprint"><button type="button" class="btn" data-a="print">{D.print}</button></p>
            <template class="linelab" data-qty={C.qty} data-msrp={T.msrp} data-sell={D.sell} data-sellp={D.sellP} data-disc={D.disc} data-line={D.line}></template>
          </section>
          <h2 class="noprint" style="margin-top:56px">{D.grid}</h2>
          {categories.map((c) => (
            <section class="cat noprint">
              <h3>{c.name}</h3>
              <div class="scroll"><table class="spec pro">
                <tr><th scope="col">{T.prod}</th><th scope="col">{C.size}</th><th scope="col">{T.msrp}</th><th scope="col">{T.cost}</th><th scope="col">{T.margin}</th></tr>
                {products.filter((p) => p.cat === c.id).flatMap((p) => sizesFor(p.slug, lang).map((z, i) => {
                  const r = prix[z.key] ?? {};
                  const m = r.pdsf != null && r.cout != null ? `${money(r.pdsf - r.cout)} (${Math.round(((r.pdsf - r.cout) / r.pdsf) * 100)} %)` : soon;
                  return (
                    <tr class={i === 0 ? 'first' : ''}>
                      <td>{i === 0 ? <a href={productUrl(p.slug, lang)}>{p.name}</a> : ''}</td>
                      <td>{z.label}</td>
                      <td class={r.pdsf == null ? 'soon' : ''}>{z.custom ? C.custom : money(r.pdsf)}</td>
                      <td class={r.cout == null ? 'soon' : ''}>{z.custom ? C.custom : money(r.cout)}</td>
                      <td class="soon">{z.custom ? '' : m}</td>
                    </tr>
                  );
                }))}
              </table></div>
            </section>
          ))}
        </>
      )}
      <p class="mn noprint"><a href="/cdn-cgi/access/logout">{T.logout}</a></p>
    </div>
  )}
</Inner>
<style is:global>
  .roles{margin-bottom:24px}
  .role{display:block;text-decoration:none;padding:28px}
  .role h2{margin-bottom:6px}
  .role span{font-size:28px;font-weight:700;color:var(--mm-copper)}
  .banner{background:var(--mm-ice);border-left:4px solid var(--mm-copper);padding:14px 18px;font-weight:500;margin-bottom:12px;max-width:760px}
  .mn{font-size:14px;color:var(--mm-graphite);margin-top:12px}
  .calc,.dq{border:1px solid var(--mm-rule);border-top:4px solid var(--mm-copper);padding:24px;margin-top:24px}
  .calc{max-width:900px}
  .cfg{display:grid;gap:12px}
  @media (min-width:800px){.calc .cfg{grid-template-columns:2fr 1.4fr}}
  .cfg label,.qty,.qhead label{display:grid;gap:4px;font-weight:600;font-size:14px}
  #pro input,#pro select{font:inherit;padding:9px;border:1px solid var(--mm-rule);background:#fff;width:100%}
  .qty{max-width:160px;margin-top:12px}
  .out,.sum{display:flex;gap:40px;flex-wrap:wrap;margin:20px 0 8px}
  .out span,.sum span{display:block;font-size:14px;color:var(--mm-graphite)}
  .out strong{font-family:var(--font-display);font-size:30px;color:var(--mm-navy)}
  .sum strong{font-family:var(--font-display);font-size:26px;color:var(--mm-navy)}
  .qhead{display:grid;gap:12px;margin:16px 0}
  @media (min-width:800px){.qhead{grid-template-columns:1fr 1fr 200px}}
  .line{border:1px solid var(--mm-rule);padding:14px;margin-bottom:10px;position:relative}
  .line .cfg{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
  .line .cfg label:first-child{grid-column:span 2}
  .nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:12px;margin-top:10px;align-items:end}
  .nums div span{display:block;font-size:13px;color:var(--mm-graphite)}
  .nums div b{font-size:16px}
  .x{position:absolute;top:6px;right:8px;border:0;background:none;font-size:22px;cursor:pointer;color:var(--mm-graphite)}
  .warn{display:block;color:#b42318;font-size:12px;margin-top:4px}
  .internal{background:var(--mm-ice);padding:12px 16px;margin-top:12px}
  .cat{margin-top:32px}
  .scroll{overflow-x:auto}
  table.pro{width:100%}
  table.pro td{padding:10px 12px;border-bottom:1px solid var(--mm-rule)}
  table.pro td:first-child{min-width:240px}
  tr.first td{border-top:2px solid var(--mm-rule)}
  .soon{color:var(--mm-graphite);font-style:italic;white-space:nowrap}
  .btn.sm{padding:6px 12px;font-size:14px}
  #pro [hidden]{display:none!important}
  .nums label{display:grid;gap:4px;font-size:13px;color:var(--mm-graphite)}
  .onlyprint{display:none}
  @media print{
    header.top,footer.foot,.page-head,.noprint{display:none!important}
    .onlyprint{display:inline}
    .dq{border:0;padding:0;margin:0}
    .line{break-inside:avoid}
    #pro input,#pro select{border:0;padding:0;appearance:none;-webkit-appearance:none;background:none;outline:none}
    #pro input::-webkit-inner-spin-button,#pro input::-webkit-calendar-picker-indicator{display:none}
  }
</style>
<script>
  const root = document.getElementById('pro');
  if (root) {
    const items = JSON.parse(root.dataset.items), cfg = JSON.parse(root.dataset.cfg), L = JSON.parse(root.dataset.l);
    const opts = root.querySelector('.tplsel').innerHTML, lab = root.querySelector('.tpllab').dataset;
    const fmt = (n) => n.toLocaleString(L.locale, { style: 'currency', currency: 'CAD' });
    const gm = (ga) => cfg.gauges.find((g) => g.ga === ga)?.m ?? null;

    // Construit un configurateur (produit, grandeur, format sur mesure, calibre, fini) dans « slot ».
    function configurator(slot, onChange) {
      slot.innerHTML = `<label>${lab.prod}<select name="p">${opts}</select></label>
        <label>${lab.size}<select name="s"></select></label>
        <label class="dA" hidden>${lab.a}<input name="a" type="number" min="1" step="0.125"></label>
        <label class="dB" hidden>${lab.b}<input name="b" type="number" min="1" step="0.125"></label>
        <label class="g">${lab.gauge}<select name="g"></select></label>
        <label>${lab.finish}<select name="f">${cfg.finishes.map((f) => `<option value="${f.id}">${f.label}</option>`).join('')}</select></label>`;
      const $ = (n) => slot.querySelector(`[name=${n}]`);
      const item = () => items.find((x) => x.slug === $('p').value);
      const fillSizes = () => {
        const it = item();
        $('s').innerHTML = it.quoteOnly ? `<option value="q">${L.custom}</option>` : it.sizes.map((z, i) => `<option value="${i}">${z.label}</option>`).join('') + (it.customOk ? `<option value="c">${L.other}</option>` : '');
        slot.querySelector('.g').hidden = !it.gauge;
        $('g').innerHTML = cfg.gauges.map((g) => `<option value="${g.ga}">${g.ga} ga</option>`).join('');
        syncGauge(); toggleDims();
      };
      const toggleDims = () => { const c = $('s').value === 'c'; slot.querySelector('.dA').hidden = !c; slot.querySelector('.dB').hidden = !c; };
      const chosen = () => {
        const it = item(), v = $('s').value;
        if (it.quoteOnly) return { it, z: null };
        if (v !== 'c') return { it, z: it.sizes[+v], rounded: false };
        const a = parseFloat($('a').value), b = parseFloat($('b').value);
        if (!(a > 0 && b > 0)) return { it, z: null, pending: true };
        const fit = it.sizes.filter((z) => z.dims[0] >= a && z.dims[1] >= b).sort((x, y) => x.dims[0] * x.dims[1] - y.dims[0] * y.dims[1]);
        return { it, z: fit[0] || null, rounded: true, tooBig: !fit.length, req: `${a} x ${b}` };
      };
      const syncGauge = () => { const z = chosen().z; if (z && z.ga) $('g').value = String(z.ga); };
      // Prix d'un champ (c = couvreur, p = PDSF, k = coût) avec multiplicateurs.
      const price = (field) => {
        const s = chosen(); if (!s.z) return null;
        const base = s.z[field]; if (base == null) return null;
        let m = 1;
        if (s.it.gauge && s.z.ga) { const sel = +$('g').value; if (sel !== s.z.ga) { const a = gm(sel), b = gm(s.z.ga); if (a == null || b == null) return null; m *= a / b; } }
        const f = cfg.finishes.find((x) => x.id === $('f').value); if (!f || f.m == null) return null; m *= f.m;
        return Math.round(base * m * 100) / 100;
      };
      const desc = () => { const s = chosen(), parts = [s.it.name]; if (s.rounded && s.req) parts.push(s.req + ' ' + L.unit); else if (s.z) parts.push(s.z.label); if (s.it.gauge) parts.push($('g').value + ' ga'); parts.push(cfg.finishes.find((x) => x.id === $('f').value).label); return parts.join(', '); };
      $('p').addEventListener('change', () => { fillSizes(); onChange(); });
      $('s').addEventListener('change', () => { toggleDims(); syncGauge(); onChange(); });
      ['a', 'b'].forEach((n) => $(n).addEventListener('input', () => { syncGauge(); onChange(); }));
      ['g', 'f'].forEach((n) => $(n).addEventListener('change', onChange));
      fillSizes();
      return { chosen, price, desc, item, $ };
    }
    const status = (s) => s.it.quoteOnly ? L.custom : s.tooBig ? L.tooBig : s.pending ? '' : s.rounded ? `${L.billed} : ${s.z.label}` : '';

    // Couvreurs : un seul configurateur.
    const calc = root.querySelector('.calc');
    if (calc) {
      const q = calc.querySelector('[name=q]'), o = (k) => calc.querySelector(`[data-o=${k}]`);
      const run = () => {
        const s = k.chosen(), qty = Math.max(1, parseInt(q.value) || 1), u = k.price('c');
        const txt = !s.z ? (s.pending ? '' : L.custom) : u == null ? L.soon : fmt(u);
        o('unit').textContent = txt; o('total').textContent = u == null ? txt : fmt(u * qty);
        o('billed').textContent = status(s);
        o('ask').href = `${L.quote}?produit=${s.it.slug}&grandeur=${encodeURIComponent(k.desc())}&quantite=${qty}`; o('fiche').href = s.it.url;
      };
      const k = configurator(calc.querySelector('[data-cfg-slot]'), run);
      q.addEventListener('input', run); run();
    }

    // Marchands : soumission client à plusieurs lignes.
    const dq = root.querySelector('.dq');
    if (dq) {
      const LL = dq.querySelector('.linelab').dataset, wrap = dq.querySelector('.lines'), lines = [];
      const out = (k, v) => (dq.querySelector(`[data-o=${k}]`).textContent = v);
      try { dq.querySelector('[name=date]').valueAsDate = new Date(); } catch (e) {}
      const recalc = () => {
        let tp = 0, ts = 0, tc = 0;
        lines.forEach((ln) => {
          const s = ln.k.chosen(), qty = Math.max(1, parseInt(ln.q.value) || 1), p = ln.k.price('p'), cost = ln.k.price('k');
          if (ln.auto && p != null) ln.v.value = p.toFixed(2);
          const v = parseFloat(ln.v.value), c = (n) => ln.el.querySelector(`[data-c=${n}]`);
          c('pdsf').textContent = !s.z ? (s.pending ? '' : L.custom) : p == null ? L.soon : fmt(p);
          c('st').textContent = status(s);
          if (p != null && !isNaN(v)) { const d = p - v; c('disc').textContent = d > 0 ? `${fmt(d * qty)} (${Math.round((d / p) * 100)} %)` : ''; tp += p * qty; }
          else c('disc').textContent = '';
          c('tot').textContent = isNaN(v) ? L.soon : fmt(v * qty);
          if (!isNaN(v)) ts += v * qty; if (cost != null) tc += cost * qty;
          c('warn').textContent = cost != null && !isNaN(v) && v < cost ? L.below : '';
        });
        out('pdsf', fmt(tp)); out('disc', fmt(Math.max(0, tp - ts))); out('client', fmt(ts));
        out('cost', tc ? fmt(tc) : L.soon); out('margin', tc ? `${fmt(ts - tc)} (${ts ? Math.round(((ts - tc) / ts) * 100) : 0} %)` : L.soon);
      };
      const add = () => {
        const el = document.createElement('div'); el.className = 'line';
        el.innerHTML = `<button type="button" class="x noprint" aria-label="${L.del}">×</button><div class="cfg"></div>
          <div class="nums"><label>${LL.qty}<input name="q" type="number" min="1" value="1"></label>
          <div><span>${LL.msrp}</span><b data-c="pdsf"></b></div>
          <label><span class="noprint">${LL.sell}</span><span class="onlyprint">${LL.sellp}</span><input name="v" type="number" min="0" step="0.01"><small class="warn noprint" data-c="warn"></small></label>
          <div><span>${LL.disc}</span><b data-c="disc"></b></div><div><span>${LL.line}</span><b data-c="tot"></b></div></div>
          <p class="mn" data-c="st"></p>`;
        wrap.appendChild(el);
        const ln = { el, auto: true, q: el.querySelector('[name=q]'), v: el.querySelector('[name=v]') };
        ln.k = configurator(el.querySelector('.cfg'), () => { ln.auto = true; recalc(); });
        ln.q.addEventListener('input', recalc);
        ln.v.addEventListener('input', () => { ln.auto = false; recalc(); });
        el.querySelector('.x').addEventListener('click', () => { el.remove(); lines.splice(lines.indexOf(ln), 1); recalc(); });
        lines.push(ln); recalc();
      };
      dq.querySelector('[data-a=add]').addEventListener('click', add);
      dq.querySelector('[data-a=print]').addEventListener('click', () => window.print());
      add();
    }
  }
</script>
