---
import Inner from '../components/Inner.astro';
import { site } from '../data/site';
import { families, models, type FamilyId, type Model } from '../data/families';
import { getProducts, productUrl, routes, type Lang } from '../i18n';
import { headline } from '../data/seo';
const { lang, family } = Astro.props as { lang: Lang; family: FamilyId };
const fr = lang === 'fr';
const F = families[family][lang];
const products = getProducts(lang);
const groups: ['airm300' | 'airm100', Model[]][] = (family === 'airm' ? ['airm300', 'airm100'] : [family]).map((f) => [f as 'airm300' | 'airm100', models(f as 'airm300' | 'airm100', lang)]);
const famUrl = (f: string) => `${routes.products[lang]}${f}/`;
const soon = fr ? 'Bientôt disponible' : 'Coming soon';
const live = groups.flatMap(([, m]) => m).filter((m) => m.slug);
const schema = [{ '@context': 'https://schema.org', '@type': 'ItemList', name: F.h1, numberOfItems: live.length, itemListElement: live.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: products.find((p) => p.slug === m.slug)!.name, url: site.url + productUrl(m.slug!, lang) })) }];
const crumbs: [string, string][] = [[fr ? 'Produits' : 'Products', routes.products[lang]]];
if (family !== 'airm') crumbs.push([fr ? 'AirM' : 'AirM', famUrl('airm')]);
---
<Inner schema={schema} crumbs={crumbs} title={F.title} description={F.desc} kicker={fr ? 'Ventilateurs de toit' : 'Roof vents'} h1={F.h1} lead={F.lead}>
  {groups.map(([f, list]) => (
    <section class="fam">
      {family === 'airm' && <h2><a href={famUrl(f)}>{f === 'airm300' ? 'AirM300' : 'AirM100'}</a></h2>}
      <div class="grid g4">
        {list.map((m) => {
          const p = m.slug ? products.find((x) => x.slug === m.slug) : undefined;
          const h = p ? headline(p, lang) : undefined;
          return p ? (
            <a class="card pc" href={productUrl(p.slug, lang)}>
              <img src={`/img/${p.slug}.webp`} alt={p.name} loading="lazy" width="400" height="400" />
              <h3>{f === 'airm300' ? 'AirM300' : 'AirM100'}, {m.label}</h3>
              <p><strong>{h!.v} {h!.u}</strong>{p.pitch ? ` · ${fr ? 'pentes' : 'pitch'} ${p.pitch}` : ''}</p>
            </a>
          ) : (
            <div class="card pc soon" aria-disabled="true">
              <div class="ph"><span>{soon}</span></div>
              <h3>{f === 'airm300' ? 'AirM300' : 'AirM100'}, {m.label}</h3>
              <p>{soon}</p>
            </div>
          );
        })}
      </div>
      {family === 'airm' && <p class="more"><a href={famUrl(f)}>{fr ? `Voir la gamme ${f === 'airm300' ? 'AirM300' : 'AirM100'}` : `See the ${f === 'airm300' ? 'AirM300' : 'AirM100'} range`} →</a></p>}
    </section>
  ))}
  {family !== 'airm' && <p class="more"><a href={famUrl('airm')}>{fr ? 'Voir tous les ventilateurs AirM' : 'See all AirM roof vents'} →</a></p>}
  <p class="btns" style="margin-top:32px"><a class="btn" href={routes.quote[lang]}>{fr ? 'Demander un prix' : 'Get a quote'}</a><a class="btn ghost" href={'tel:' + site.phone}>{site.phoneDisplay}</a></p>
</Inner>
<style>
  .fam{margin-bottom:48px}
  .fam h2 a{text-decoration:none;color:inherit}
  .pc img{height:160px;width:100%;object-fit:contain;background:var(--mm-mist);margin-bottom:12px}
  .pc h3{margin-bottom:4px}
  .pc strong{color:var(--mm-navy)}
  .soon{opacity:.7;cursor:default}
  .soon .ph{height:160px;display:grid;place-items:center;background:var(--mm-mist);margin-bottom:12px;border:1px dashed var(--mm-rule)}
  .soon .ph span{font-weight:600;color:var(--mm-graphite)}
  .soon p{color:var(--mm-graphite)}
  .more{margin-top:16px;font-weight:600}
</style>
