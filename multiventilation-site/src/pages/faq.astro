---
import Inner from '../components/Inner.astro';
import { faq } from '../data/site';
const schema = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
---
<Inner schema={schema} title="Questions fréquentes sur la ventilation de toiture | Multi-Ventilation" description="Délais, couleurs, normes, calcul de la ventilation d’entretoit, garantie et revente : les réponses aux questions des couvreurs et des revendeurs." h1="Questions fréquentes">
  <div style="max-width:820px">{faq.map(([q, a]) => <details open><summary>{q}</summary><p>{a}</p></details>)}</div>
</Inner>
