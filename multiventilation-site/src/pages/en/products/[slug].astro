---
import V from '../../../views/Product.astro';
import { products } from '../../../data/produits';
import { enSlugs } from '../../../i18n';
export function getStaticPaths() { return products.map((p) => ({ params: { slug: enSlugs[p.slug] ?? p.slug }, props: { fr: p.slug } })); }
---
<V lang="en" slug={Astro.props.fr} />
