---
import Inner from '../components/Inner.astro';
import LeadForm from '../components/LeadForm.astro';
import CatalogueDownload from '../components/CatalogueDownload.astro';
import type { Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
const L = fr ? {
  title: 'Devenir revendeur Multi-Ventilation : distributeurs et quincailleries | Multi-Ventilation',
  desc: 'Distributeurs, quincailleries et marchands de matériaux : offrez à vos clients couvreurs une ventilation de toiture sur mesure, couleur assortie, fabriquée en 5 jours. Québec, Ontario, Maritimes.',
  kicker: 'Revendeurs', h1: 'Offrez Multi-Ventilation à vos clients', lead: 'Vos clients couvreurs attendent des semaines pour un aérateur sur mesure. Avec Multi-Ventilation, ils l’ont en 5 jours, dans la couleur de leur toiture.',
  why: 'Pourquoi nous revendre',
  li: [['Un délai que personne n’offre :', '5 jours pour du sur mesure.'], ['Toutes les couleurs :', 'les palettes d’Ideal Roofing, Vicwest, MAC, Agway Metals et Color Steels.'], ['Une gamme complète :', '21 produits, des aérateurs résidentiels aux sorties commerciales et agricoles.'], ['Des produits testés :', 'AirM300 et Dôme 480 selon CAN3-A93-M82 (R2003).'], ['Un fabricant établi :', 'Multi-Moulures, plus de 35 ans, 2 usines au Québec.']],
  terr: 'Territoires', terrP: 'Nous développons notre réseau de revendeurs au Québec, en Ontario et dans les Maritimes. Dans les régions où nous avons un revendeur, nous lui dirigeons les demandes des couvreurs de son secteur.',
  todo: 'À compléter : conditions de distribution, matériel de présentation, présentoirs ou échantillons.',
} : {
  title: 'Become a Multi-Ventilation reseller: distributors and building supply stores | Multi-Ventilation',
  desc: 'Distributors, building supply stores and dealers: offer your roofing customers custom, colour-matched roof ventilation made in 5 days. Quebec, Ontario, Maritimes.',
  kicker: 'Resellers', h1: 'Offer Multi-Ventilation to your customers', lead: 'Your roofing customers wait weeks for a custom vent. With Multi-Ventilation, they get it in 5 days, in the colour of their roof.',
  why: 'Why carry our products',
  li: [['A lead time few can match:', '5 days for custom work.'], ['Every colour:', 'the Ideal Roofing, Vicwest, MAC, Agway Metals and Color Steels palettes.'], ['A complete range:', '21 products, from residential roof vents to commercial and agricultural outlets.'], ['Tested products:', 'AirM300 and 480 Dome to CAN3-A93-M82 (R2003).'], ['An established manufacturer:', 'Multi-Moulures, over 35 years, 2 plants in Quebec.']],
  terr: 'Territories', terrP: 'We are building our reseller network in Quebec, Ontario and the Maritimes. Where we have a reseller, we send them the requests from roofers in their area.',
  todo: 'To complete: distribution terms, sales material, displays or samples.',
};
---
<Inner title={L.title} description={L.desc} kicker={L.kicker} h1={L.h1} lead={L.lead}>
  <CatalogueDownload />
  <div class="grid g2">
    <div>
      <h2>{L.why}</h2>
      <ul class="ticks">{L.li.map(([b, s]) => <li><strong>{b}</strong> {s}</li>)}</ul>
      <h2>{L.terr}</h2>
      <p>{L.terrP}</p>
      <p class="todo">{L.todo}</p>
    </div>
    <LeadForm kind="revendeur" />
  </div>
</Inner>
<style>.ticks{padding-left:20px;display:grid;gap:8px}</style>
