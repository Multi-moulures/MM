---
import Inner from '../components/Inner.astro';
import { getFaq, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
const faq = getFaq(lang);
const schema = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
---
<Inner schema={schema} title={fr ? 'FAQ ventilation d’entretoit : SFVA, PCM, condensation' : 'Attic Ventilation FAQ: NFVA, CFM, Condensation | Multi-Ventilation'} description={fr ? 'Combien de ventilation pour un entretoit, SFVA ou PCM, soffite et aérateur, condensation, pente minimale, délai et garantie : nos réponses.' : 'How much attic ventilation you need, NFVA versus CFM, soffit and vent pairing, condensation, minimum pitch, lead time and warranty.'} h1={fr ? 'Ventilation de toiture : questions fréquentes' : 'Roof ventilation: frequently asked questions'}>
  <div class="faq">{faq.map(([q, a]) => <section><h2>{q}</h2><p>{a}</p></section>)}</div>
</Inner>
<style>
  .faq{max-width:820px}
  .faq section{border-bottom:1px solid var(--mm-rule);padding:20px 0}
  .faq h2{font-size:20px;margin-bottom:8px}
  .faq p{margin:0}
</style>
