---
import Inner from '../components/Inner.astro';
import { getFaq, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
const faq = getFaq(lang);
const schema = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
---
<Inner schema={schema} title={fr ? 'Ventilation d’entretoit : SFVA, PCM et condensation | FAQ' : 'Attic ventilation FAQ: NFVA, CFM and condensation'} description={fr ? 'Combien de ventilation pour un entretoit, SFVA ou PCM, condensation, toiture métallique, faible pente, AirM100 ou AirM300 : nos réponses.' : 'How much attic ventilation, NFVA vs CFM, condensation, metal roofs, low slopes, AirM100 or AirM300: answers for roofers and building owners.'} h1={fr ? 'Ventilation de toiture : questions fréquentes' : 'Roof ventilation: frequently asked questions'}>
  <div style="max-width:820px">{faq.map(([q, a]) => <details open><summary>{q}</summary><p>{a}</p></details>)}</div>
</Inner>
