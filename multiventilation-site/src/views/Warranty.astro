---
import Inner from '../components/Inner.astro';
import { warranty, warrantyUpdated } from '../data/warranty';
import type { Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
const w = warranty[lang];
---
<Inner title={fr ? 'Garantie à vie limitée | Multi-Ventilation' : 'Limited lifetime warranty | Multi-Ventilation'} description={fr ? 'Garantie à vie limitée sur les défauts de fabrication, remplacement sans frais pendant 10 ans, 10 ans sur la peinture, transférable. Conditions et réclamations.' : 'Limited lifetime warranty on manufacturing defects, free replacement for 10 years, 10 years on paint, transferable. Terms and claims.'} kicker={fr ? 'Garantie' : 'Warranty'} h1={fr ? 'Notre garantie' : 'Our warranty'} lead={w.intro}>
  <p class="todo">{fr ? 'Ébauche à faire valider par Laurie avant la mise en ligne.' : 'Draft, to be reviewed before launch.'}</p>
  <div class="hl">{w.highlights.map(([b, s]) => <div><b>{b}</b>{s}</div>)}</div>
  <div class="wb">
    {w.sections.map((s) => <section><h2>{s.h}</h2>{s.p?.map((x) => <p>{x}</p>)}{s.li && <ul>{s.li.map((x) => <li>{x}</li>)}</ul>}</section>)}
    <p class="upd">{fr ? 'Dernière mise à jour : ' : 'Last updated: '}{warrantyUpdated[lang]}</p>
  </div>
</Inner>
<style>
  .hl{display:grid;grid-template-columns:repeat(2,1fr);gap:0;margin:8px 0 48px;border:1px solid var(--mm-rule)}
  @media (min-width:900px){.hl{grid-template-columns:repeat(4,1fr)}}
  .hl div{display:grid;gap:4px;padding:24px;border-left:4px solid var(--mm-copper);color:var(--mm-graphite);font-size:15px}
  .hl b{font-family:var(--font-display);font-size:28px;color:var(--mm-navy);line-height:1.1}
  .wb{max-width:780px}
  .wb section{margin-bottom:36px}
  .wb h2{font-size:24px}
  .wb ul{padding-left:20px;display:grid;gap:8px}
  .upd{font-size:14px;color:var(--mm-ash)}
</style>
