---
import { langOf, routes } from '../i18n';
const { kind = 'couvreur' } = Astro.props as { kind?: string };
const fr = langOf(Astro.url.pathname) === 'fr';
const provinces = fr
  ? ['Québec', 'Ontario', 'Nouveau-Brunswick', 'Nouvelle-Écosse', 'Île-du-Prince-Édouard', 'Terre-Neuve-et-Labrador', 'Manitoba', 'Saskatchewan', 'Alberta', 'Colombie-Britannique', 'Territoires', 'États-Unis', 'Autre pays']
  : ['Quebec', 'Ontario', 'New Brunswick', 'Nova Scotia', 'Prince Edward Island', 'Newfoundland and Labrador', 'Manitoba', 'Saskatchewan', 'Alberta', 'British Columbia', 'Territories', 'United States', 'Other country'];
const L = fr
  ? { who: 'Vous êtes', roofer: 'Couvreur ou entrepreneur', reseller: 'Revendeur, distributeur ou quincaillerie', other: 'Autre (architecte, propriétaire, gestionnaire)', prov: 'Province ou région', city: 'Ville', co: 'Entreprise', name: 'Votre nom', phone: 'Téléphone', email: 'Courriel', msg: 'Produits, grandeurs, couleur et quantités', send: 'Envoyer', todo: 'Formulaire à brancher : chaque demande doit arriver avec son type et sa région pour être dirigée vers la bonne personne.' }
  : { who: 'You are', roofer: 'Roofer or contractor', reseller: 'Reseller, distributor or building supply store', other: 'Other (architect, owner, property manager)', prov: 'Province or region', city: 'City', co: 'Company', name: 'Your name', phone: 'Phone', email: 'Email', msg: 'Products, sizes, colour and quantities', send: 'Send', todo: 'Form to connect.' };
---
<form class="order lead" method="post" action="#" data-lead data-lang={fr ? 'fr' : 'en'}>
  <fieldset class="who">
    <legend>{L.who}</legend>
    <label class="opt"><input type="radio" name="type" value="couvreur" checked={kind === 'couvreur'} /> {L.roofer}</label>
    <label class="opt"><input type="radio" name="type" value="revendeur" checked={kind === 'revendeur'} /> {L.reseller}</label>
    <label class="opt"><input type="radio" name="type" value="autre" checked={kind === 'autre'} /> {L.other}</label>
  </fieldset>
  <label>{L.prov}<select name="province" required>{provinces.map((p) => <option>{p}</option>)}</select></label>
  <label>{L.city}<input name="ville" required autocomplete="address-level2" /></label>
  <label>{L.co}<input name="entreprise" autocomplete="organization" /></label>
  <label>{L.name}<input name="nom" required autocomplete="name" /></label>
  <label>{L.phone}<input name="telephone" type="tel" required autocomplete="tel" /></label>
  <label>{L.email}<input name="courriel" type="email" autocomplete="email" /></label>
  <label>{L.msg}<textarea name="message" rows="4"></textarea></label>
  <label class="opt share"><input type="checkbox" name="partage_revendeur" value="oui" /> {fr ? 'J’accepte que ma demande soit transmise au revendeur Multi-Ventilation de ma région, s’il y en a un (facultatif).' : 'I agree that my request may be sent to the Multi-Ventilation reseller in my region, if there is one (optional).'}</label>
  <p class="consent">{fr ? <>En envoyant ce formulaire, vous acceptez que Multi-Moulures utilise vos renseignements pour répondre à votre demande, selon notre <a href={routes.privacy.fr}>politique de confidentialité</a>.</> : <>By sending this form, you agree that Multi-Moulures may use your information to answer your request, as described in our <a href={routes.privacy.en}>privacy policy</a>.</>}</p>
  <button class="btn" type="submit">{L.send}</button>
  <p class="route" role="status" hidden></p>
  <p class="todo">{L.todo}</p>
</form>
<script>
  document.querySelectorAll('form[data-lead]').forEach((f) => {
    const out = f.querySelector('.route') as HTMLElement;
    const fr = (f as HTMLElement).dataset.lang === 'fr';
    const msg = () => {
      const t = (f.querySelector('input[name=type]:checked') as HTMLInputElement)?.value;
      const sel = f.querySelector('select[name=province]') as HTMLSelectElement;
      const qc = sel.selectedIndex === 0;
      if (t === 'revendeur') return fr ? 'Notre équipe des ventes aux revendeurs vous contactera pour vous présenter les conditions de distribution' + (qc ? '.' : ' dans votre région.') : 'Our reseller sales team will contact you with distribution terms' + (qc ? '.' : ' for your region.');
      if (t === 'couvreur' && !qc) return fr ? 'Nous vous servirons directement ou vous dirigerons vers un revendeur Multi-Ventilation près de chez vous.' : 'We will serve you directly or refer you to a Multi-Ventilation reseller near you.';
      return fr ? 'Un conseiller vous rappellera avec un prix et un délai de fabrication.' : 'An advisor will call you back with a price and a production date.';
    };
    f.addEventListener('change', () => { out.hidden = false; out.textContent = msg(); });
    f.addEventListener('submit', (e) => { e.preventDefault(); out.hidden = false; out.textContent = (fr ? 'Merci. ' : 'Thank you. ') + msg(); });
  });
</script>
<style>
  .who{border:0;padding:0;margin:0;display:grid;gap:8px}
  .who legend{font-weight:500;margin-bottom:6px}
  .opt{display:flex!important;gap:10px;align-items:center;font-weight:400!important;border:1px solid var(--mm-rule);padding:12px;background:#fff;cursor:pointer}
  .opt input{width:auto}
  .share{font-size:15px}
  .consent{font-size:14px;color:var(--mm-graphite);margin:0}
  .route{background:var(--mm-ice);padding:12px 14px;margin:0;color:var(--mm-navy);font-weight:500}
</style>
