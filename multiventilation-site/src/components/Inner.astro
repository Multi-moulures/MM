---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
interface Props { title: string; description: string; h1: string; kicker?: string; lead?: string; schema?: object[]; crumbs?: [string, string][] }
const { title, description, h1, kicker, lead, schema = [], crumbs = [] } = Astro.props;
const trail: [string, string][] = [['Accueil', '/'], ...crumbs];
const bc = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [...trail, [h1, Astro.url.pathname]].map(([n, u], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: site.url + u })) };
---
<Base title={title} description={description} schema={[bc, ...schema]}>
  <section class="page-head"><div class="wrap">
    <div class="crumbs">{trail.map(([n, u]) => <><a href={u}>{n}</a> / </>)}<span>{h1}</span></div>
    {kicker && <p class="caps">{kicker}</p>}
    <h1>{h1}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div></section>
  <section class="section"><div class="wrap"><slot /></div></section>
</Base>
