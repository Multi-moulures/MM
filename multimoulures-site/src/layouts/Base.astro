---
import '../styles/global.css';
import { company, nav, routes, t, type Lang } from '../data/site';

interface Props { lang: Lang; title: string; description: string; alt: string; schema?: object[]; heroLogo?: boolean }
const { lang, title, description, alt, schema = [], heroLogo = false } = Astro.props;
const tx = t[lang];
const site = 'https://multimoulures.com';
const path = Astro.url.pathname;
const frPath = lang === 'fr' ? path : alt;
const enPath = lang === 'en' ? path : alt;
const en = company.englishLive;

const org = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': site + '/#org',
  name: company.name,
  alternateName: 'Multi-Moulures',
  url: site,
  logo: site + '/img/mm.png',
  telephone: company.phone,
  email: company.email,
  foundingDate: String(new Date().getFullYear() - company.foundedYears),
  numberOfEmployees: company.employees,
  description: tx.footerAbout,
  address: { '@type': 'PostalAddress', streetAddress: company.street, addressLocality: company.city, addressRegion: company.region, postalCode: company.postal, addressCountry: 'CA' },
  knowsLanguage: ['fr', 'en'],
  areaServed: [{ '@type': 'City', name: 'Montréal' }, { '@type': 'AdministrativeArea', name: 'Montérégie' }, { '@type': 'AdministrativeArea', name: 'Québec' }],
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: company.hours.open, closes: company.hours.close }],
  audience: { '@type': 'BusinessAudience', name: lang === 'fr' ? 'Couvreurs, entrepreneurs et revendeurs' : 'Roofers, contractors and resellers' },
};
---
<!doctype html>
<html lang={lang === 'fr' ? 'fr-CA' : 'en-CA'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site + path} />
  {en && <link rel="alternate" hreflang="fr-CA" href={site + frPath} />}
  {en && <link rel="alternate" hreflang="en-CA" href={site + enPath} />}
  {en && <link rel="alternate" hreflang="x-default" href={site + frPath} />}
  {!en && lang === 'en' && <meta name="robots" content="noindex,nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
  <link rel="icon" href="/img/mm.png" />
  <script type="application/ld+json" set:html={JSON.stringify([org, ...schema])} />
</head>
<body>
  <header class={heroLogo ? "top home" : "top"}>
    <div class="wrap bar">
      {!heroLogo && <a class="brand" href={routes.home[lang]} aria-label="Multi-Moulures">
        <img class="logo" src="/img/logo-mm.png" alt="Multi-Moulures, pliage de métal en feuille" width="797" height="243" />
      </a>}
      <nav aria-label="Navigation">
        {nav.map((n) => <a href={routes[n.key][lang]} aria-current={path === routes[n.key][lang] ? 'page' : undefined}>{n[lang]}</a>)}
      </nav>
      <div class="actions">
        {(en || lang === 'en') && <a class="lang" href={alt} hreflang={lang === 'fr' ? 'en' : 'fr'}>{tx.switchLang}</a>}
        <a class="btn small copper" href={'tel:' + company.phone}>{tx.callAdvisor}</a>
        <details class="menu">
          <summary aria-label="Menu"><span></span><span></span><span></span></summary>
          <div class="drop">
            {nav.map((n) => <a href={routes[n.key][lang]}>{n[lang]}</a>)}
            <a href={routes.faq[lang]}>FAQ</a>
            <a href={routes.account[lang]}>{tx.account}</a>
            {(en || lang === 'en') && <a href={alt} hreflang={lang === 'fr' ? 'en' : 'fr'}>{tx.switchLang}</a>}
          </div>
        </details>
      </div>
    </div>
  </header>
  <main><slot /></main>
  <footer class="foot">
    <div class="wrap fgrid">
      <div>
        <p class="slogan"><span>{tx.slogan[0]}</span> <em>{tx.slogan[1]}</em></p>
      </div>
      <div>
        <p class="caps light">Contact</p>
        <p><a href={'tel:' + company.phone}>{company.phoneDisplay}</a><br /><a href={'tel:' + company.phone2}>{company.phone2Display}</a><br /><a href={'mailto:' + company.email}>{company.email}</a></p>
        <p>{company.street}<br />{company.city} (Québec) {company.postal}</p>
      </div>
      <div>
        <p class="caps light">{lang === 'fr' ? 'Liens' : 'Links'}</p>
        <p class="flinks">
          <a href="/docs/catalogue-multi-moulures.pdf" download>{lang === 'fr' ? 'Catalogue (PDF)' : 'Catalogue (PDF)'}</a>
          <a href={routes.account[lang]}>{tx.account}</a>
          <a href={routes.distributors[lang]}>{lang === 'fr' ? 'Distributeurs' : 'Distributors'}</a>
          <a href={routes.faq[lang]}>FAQ</a>
          <a href={routes.careers[lang]}>{lang === 'fr' ? 'Emplois' : 'Careers'}</a>
          <a href={company.ventilationSite}>Multi-Ventilation</a>
          <a href={routes.warranty[lang]}>{lang === 'fr' ? 'Garantie ventilation' : 'Ventilation warranty'}</a>
          <a href={routes.privacy[lang]}>{lang === 'fr' ? 'Confidentialité' : 'Privacy'}</a>
        </p>
      </div>
    </div>
    <div class="wrap legal">© {new Date().getFullYear()} {company.name} {tx.rights}</div>
  </footer>
</body>
</html>

<style>
  .top{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid var(--mm-rule)}
  .bar{display:flex;align-items:center;gap:24px;min-height:100px}
  .brand{display:flex;align-items:center;gap:10px;flex-shrink:0}
  .brand .logo{height:84px;width:auto;margin-block:6px}
  nav{display:flex;gap:18px;margin-left:auto}
  .home .bar{min-height:68px}
  .home nav{flex:1;justify-content:space-between;margin-left:0;margin-right:16px}
  .home nav a{font-size:15px}
  nav a{white-space:nowrap;font-family:var(--font-display);font-weight:600;font-size:14px;color:var(--mm-slate);text-decoration:none;padding:6px 0;border-bottom:2px solid transparent}
  nav a:hover,nav a[aria-current]{color:var(--mm-navy);border-color:var(--mm-copper)}
  .actions{display:flex;align-items:center;gap:16px}
  .lang{font-size:14px;color:var(--mm-graphite)}
  .btn.small{padding:10px 16px;font-size:14px;white-space:nowrap}
  @media (max-width:1240px){nav{display:none}.actions{margin-left:auto}.lang{display:none}}
  .menu{position:relative;display:none}
  @media (max-width:1240px){.menu{display:block}}
  .menu summary{list-style:none;cursor:pointer;width:44px;height:44px;display:grid;place-content:center;gap:5px;border:1px solid var(--mm-rule)}
  .menu summary::-webkit-details-marker{display:none}
  .menu summary span{display:block;width:20px;height:2px;background:var(--mm-navy)}
  .drop{position:absolute;right:0;top:52px;background:#fff;border:1px solid var(--mm-rule);min-width:240px;display:grid;box-shadow:0 8px 24px rgba(16,41,74,.12)}
  .drop a{padding:14px 18px;text-decoration:none;font-family:var(--font-display);font-weight:600;font-size:15px;color:var(--mm-navy);border-bottom:1px solid var(--mm-mist)}
  .drop a:hover{background:var(--mm-ice)}
  @media (max-width:520px){.brand .logo{height:52px}.btn.small{padding:9px 12px;font-size:13px}}
  @media (max-width:420px){.actions .btn.small{display:none}}
  .foot{background:var(--mm-navy-deep);color:#fff;padding:40px 0 20px;margin-top:0;font-size:15px}
  .foot a{color:#fff}
  .fgrid{display:grid;gap:32px}
  @media (min-width:800px){.fgrid{grid-template-columns:1.4fr 1fr 1fr}}
  .slogan{font-family:var(--font-display);font-size:24px;font-weight:700;line-height:1.15;margin-bottom:12px}
  .slogan span{color:var(--mm-sky)}
  .slogan em{font-style:italic}
  .fabout{color:var(--mm-sky)}
  .caps.light{color:var(--mm-sky)}
  .flinks{display:grid;gap:4px}
  .foot p{margin-bottom:8px}
  .legal{border-top:1px solid #0a4d8a;margin-top:20px;padding-top:12px;font-size:13px;color:var(--mm-sky)}
</style>
