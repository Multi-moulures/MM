---
import Inner from './Inner.astro';
import { routes, company, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
const c = fr ? {
  title: 'À propos : deux usines, 35 ans de pliage de métal au Québec | Multi-Moulures',
  desc: 'Multi-Moulures, fabricant québécois de moulures de métal et de ventilation de toiture sur mesure : deux usines, plus de 40 000 feuilles en stock, plus de 35 ans de savoir-faire.',
  h1: 'Le partenaire de pliage des couvreurs', lead: 'Plus de 35 ans à plier du métal pour ceux qui couvrent le Québec.',
  pillars: [['Toutes les couleurs.', 'Plus de 40 000 feuilles d’acier et d’aluminium, dans les couleurs des grands fabricants de revêtement. La production démarre dès votre commande confirmée.'], ['Tous les profils.', 'Plus de 160 profils au catalogue, ou votre propre dessin. Tolérances serrées, ourlets propres, poinçonnage CNC : des pièces qui s’installent du premier coup.'], ['Quand tu en as besoin.', 'Délai standard de 72 heures pour les moulures, 5 jours pour la ventilation sur mesure. Cueillette à Saint-Bruno ou livraison au chantier.']],
  plantsH: 'Deux usines. Une seule exigence : la précision.', plantsP: 'Nos deux usines de 20 000 pi² regroupent huit plieuses, dont une de 20 pieds, trois cisailles, deux poinçonneuses CNC et des profileuses, opérées par une équipe de 70 personnes. Cette capacité absorbe les gros chantiers comme les semaines de pointe.',
  storyH: 'Notre histoire', story: ['Fondée par Yves et Patrick Mathieu il y a plus de 35 ans, Multi-Moulures fabrique des moulures et composantes de métal sur mesure pour la toiture, le revêtement et l’enveloppe du bâtiment.', 'L’entreprise est aujourd’hui dirigée par Marc Edwards et Charles Lambert. Yves demeure en place, avec toute l’équipe.'],
  numsH: 'En chiffres', visit: 'Planifier une visite de l’usine', photo: 'Photo à venir',
  rows: [['Fondée', 'Il y a plus de 35 ans'], ['Usines', '2 usines de 20 000 pi²'], ['Plieuses', '8, dont une de 20 pieds'], ['Cisailles', '3'], ['Poinçonneuses CNC', '2'], ['Équipe', '70 employés'], ['Inventaire', 'Plus de 40 000 feuilles'], ['Profils au catalogue', 'Plus de 160']],
} : {
  title: 'About: two plants, 35 years of sheet metal bending in Quebec | Multi-Moulures',
  desc: 'Multi-Moulures, Quebec manufacturer of custom metal flashings and roof vents: two plants, over 40,000 sheets in stock, over 35 years of know-how.',
  h1: 'The roofer’s bending partner', lead: 'Over 35 years bending metal for the people who roof Quebec.',
  pillars: [['Every colour.', 'Over 40,000 sheets of steel and aluminium, in the colours of the major cladding makers. Production starts as soon as your order is confirmed.'], ['Every profile.', 'Over 160 catalogue profiles, or your own drawing. Tight tolerances, clean hems, CNC punching: parts that install the first time.'], ['When you need it.', '72 hour standard turnaround on flashings, 5 days on custom vents. Pickup in Saint-Bruno or jobsite delivery.']],
  plantsH: 'Two plants. One standard: precision.', plantsP: 'Our two 20,000 sq ft plants house eight brakes, including a 20 foot brake, three shears, two CNC punches and roll formers, run by a team of 70. That capacity absorbs big jobs and peak weeks alike.',
  storyH: 'Our story', story: ['Founded by Yves and Patrick Mathieu over 35 years ago, Multi-Moulures makes custom metal flashings and components for roofing, cladding and the building envelope.', 'The company is now led by Marc Edwards and Charles Lambert. Yves remains in place, with the whole team.'],
  numsH: 'By the numbers', visit: 'Book a plant visit', photo: 'Photo to come',
  rows: [['Founded', 'Over 35 years ago'], ['Plants', '2 plants of 20,000 sq ft'], ['Brakes', '8, including a 20 foot brake'], ['Shears', '3'], ['CNC punching', '2'], ['Team', '70 employees'], ['Inventory', 'Over 40,000 sheets'], ['Catalogue profiles', 'Over 160']],
};
---
<Inner lang={lang} alt={routes.about[fr ? 'en' : 'fr']} title={c.title} description={c.desc} kicker={fr ? 'À propos' : 'About'} h1={c.h1} lead={c.lead}>
  <div class="pgrid">{c.pillars.map(([h, p]) => <div class="pillar"><h2>{h}</h2><p>{p}</p></div>)}</div>

  <div class="split">
    <div class="ph-slot tall"><span class="todo">{c.photo} : les deux usines</span></div>
    <div>
      <h2>{c.plantsH}</h2>
      <p class="lead">{c.plantsP}</p>
      <a class="btn copper" href={routes.contact[lang] + '#visite'}>{c.visit}</a>
    </div>
  </div>

  <div class="split">
    <div>
      <h2>{c.storyH}</h2>
      {c.story.map((p) => <p>{p}</p>)}
    </div>
    <table class="spec">
      <tr><th colspan="2">{c.numsH}</th></tr>
      {c.rows.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}
    </table>
  </div>
  <div class="ph-slot team"><span class="todo">{c.photo} : l’équipe</span></div>
</Inner>
<style>
  .pgrid{display:grid;gap:0;margin-bottom:64px}
  @media (min-width:800px){.pgrid{grid-template-columns:repeat(3,1fr)}}
  .pillar{border-left:4px solid var(--mm-copper);padding:8px 28px 8px 24px;margin-bottom:24px}
  .pillar h2{font-size:26px;margin-bottom:8px}
  .pillar p{color:var(--mm-graphite);margin:0}
  .split{display:grid;gap:40px;align-items:center;margin-bottom:64px}
  @media (min-width:900px){.split{grid-template-columns:1fr 1fr}}
  .tall{aspect-ratio:4/3;width:100%}
  .team{aspect-ratio:21/9;width:100%}
</style>
