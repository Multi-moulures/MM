---
import Inner from './Inner.astro';
import { routes, company, type Lang } from '../data/site';
const { lang, kind } = Astro.props as { lang: Lang; kind: 'regions' | 'contact' | 'careers' };
const fr = lang === 'fr';
const other: Lang = fr ? 'en' : 'fr';
const meta = {
  regions: { h1: fr ? 'Régions desservies' : 'Service areas', title: fr ? 'Régions desservies : cueillette et livraison | Multi-Moulures' : 'Service areas: pickup and delivery | Multi-Moulures', d: fr ? 'Cueillette à Saint-Bruno-de-Montarville ou livraison sur chantier au Québec.' : 'Pickup in Saint-Bruno-de-Montarville or jobsite delivery in Quebec.' },
  contact: { h1: 'Contact', title: fr ? 'Contact | Multi-Moulures, Saint-Bruno-de-Montarville' : 'Contact | Multi-Moulures, Saint-Bruno-de-Montarville', d: fr ? 'Téléphone, courriel et adresse de Multi-Moulures.' : 'Multi-Moulures phone, email and address.' },
  careers: { h1: fr ? 'Emplois' : 'Careers', title: fr ? 'Emplois en pliage de métal à Saint-Bruno | Multi-Moulures' : 'Sheet metal jobs in Saint-Bruno | Multi-Moulures', d: fr ? 'Joignez une équipe de 70 personnes en pliage et fabrication de métal en feuille.' : 'Join a 70 person sheet metal bending and fabrication team.' },
}[kind];
---
<Inner lang={lang} alt={routes[kind][other]} title={meta.title} description={meta.d} h1={meta.h1}>
  {kind === 'contact' && (
    <div><div class="grid g4">
      <div class="card"><h3>{fr ? 'Téléphone' : 'Phone'}</h3><p><a href={'tel:' + company.phone}>{company.phoneDisplay}</a></p></div>
      <div class="card"><h3>{fr ? 'Courriel' : 'Email'}</h3><p><a href={'mailto:' + company.email}>{company.email}</a></p></div>
      <div class="card"><h3>{fr ? 'Usine' : 'Plant'}</h3><p>{company.street}<br />{company.city} (Québec) {company.postal}</p></div>
      <div class="card"><h3>{fr ? 'Heures' : 'Hours'}</h3><p>{fr ? 'Lundi au vendredi' : 'Monday to Friday'}<br />{fr ? '7 h 30 à 16 h 30' : '7:30 a.m. to 4:30 p.m.'}</p><p style="font-size:15px">{fr ? 'Cueillette en continu. Téléphone fermé de 12 h à 12 h 30.' : 'Pickup open all day. Phones closed 12:00 to 12:30.'}</p></div>
    </div>
    <div id="visite" class="card" style="margin-top:32px;background:var(--mm-ice);border-color:var(--mm-ice)">
      <h2>{fr ? 'Planifier une visite de l’usine' : 'Book a plant visit'}</h2>
      <p>{fr ? 'Venez voir notre inventaire de 40 000 feuilles, nos plieuses et notre équipe. Appelez-nous ou écrivez-nous pour fixer un moment.' : 'Come see our 40,000 sheet inventory, our brakes and our team. Call or email us to set a time.'}</p>
      <p class="btns" style="margin-top:16px"><a class="btn" href={'tel:' + company.phone}>{company.phoneDisplay}</a><a class="btn ghost" href={'mailto:' + company.email + '?subject=' + encodeURIComponent(fr ? 'Visite de l’usine' : 'Plant visit')}>{company.email}</a></p>
    </div></div>
  )}
  {kind === 'regions' && (
    <div class="grid g2">
      <div class="card"><h3>{fr ? 'Cueillette à Saint-Bruno' : 'Pickup in Saint-Bruno'}</h3><p>{company.street}, {company.city}. {fr ? 'Lundi au vendredi, 7 h 30 à 16 h 30, en continu.' : 'Monday to Friday, 7:30 a.m. to 4:30 p.m., all day.'}</p></div>
      <div class="card"><h3>{fr ? 'Livraison au chantier' : 'Jobsite delivery'}</h3><p>{fr ? `Nous livrons dans ${company.deliveryArea.fr}. Votre chantier est ailleurs au Québec ou en Ontario ? Appelez-nous : on trouve une solution.` : `We deliver across ${company.deliveryArea.en}. Jobsite elsewhere in Quebec or Ontario? Call us and we will find a solution.`}</p><p style="margin-top:12px"><a class="btn" href={'tel:' + company.phone}>{company.phoneDisplay}</a></p></div>
    </div>
  )}
  {kind === 'careers' && <p class="todo">{fr ? 'À compléter : postes ouverts. Cette page permet aux offres d’emploi de ne plus dépasser l’accueil dans les résultats de recherche.' : 'To complete: open positions.'}</p>}
</Inner>
