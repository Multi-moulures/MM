---
const { d, size = 'sm' } = Astro.props as { d: string; size?: 'sm' | 'lg' };
---
<svg class={'profile ' + size} viewBox="0 0 120 80" aria-hidden="true">
  <path d={d} fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="miter" stroke-linecap="square" />
</svg>
<style>
  .profile{color:var(--mm-navy);display:block}
  .sm{width:96px;height:64px}
  .lg{width:100%;max-width:360px;height:auto;background:var(--mm-ice);padding:24px}
</style>
