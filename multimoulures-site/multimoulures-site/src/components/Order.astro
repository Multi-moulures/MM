---
import Inner from './Inner.astro';
import { routes, company, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
---
<Inner lang={lang} alt={routes.order[fr ? 'en' : 'fr']}
  title={fr ? 'Demander un prix : moulures et ventilation sur mesure | Multi-Moulures' : 'Get a quote: custom flashings and roof vents | Multi-Moulures'}
  description={fr ? 'Envoyez une photo, un croquis, un PDF ou un DXF. Un conseiller valide vos mesures et la production démarre sans attendre l’acier.' : 'Send a photo, sketch, PDF or DXF. An advisor confirms your measurements and production starts without waiting for steel.'}
  kicker={fr ? 'Un croquis suffit' : 'A sketch is enough'} h1={fr ? 'Demander un prix' : 'Get a quote'}
  lead={fr ? 'Photo de cellulaire, dessin à main levée, PDF, DXF, liste de pièces ou vieille pièce. Envoyez ce que vous avez.' : 'Phone photo, hand drawing, PDF, DXF, a parts list or an old piece. Send what you have.'}>
  <div class="grid g2">
    <form class="order" method="post" action="#" enctype="multipart/form-data">
      <label>{fr ? 'Nom et entreprise' : 'Name and company'}<input name="name" required autocomplete="organization" /></label>
      <label>{fr ? 'Téléphone' : 'Phone'}<input name="phone" type="tel" required autocomplete="tel" /></label>
      <label>{fr ? 'Courriel' : 'Email'}<input name="email" type="email" autocomplete="email" /></label>
      <label>{fr ? 'Croquis, photo ou plan' : 'Sketch, photo or drawing'}<input name="file" type="file" multiple accept="image/*,.pdf,.dxf,.dwg" /></label>
      <label>{fr ? 'Couleur, calibre, quantités, date requise' : 'Colour, gauge, quantities, date needed'}<textarea name="details" rows="5"></textarea></label>
      <label>{fr ? 'Récupération' : 'Fulfilment'}
        <select name="fulfil"><option>{fr ? 'Cueillette à Saint-Bruno' : 'Pickup in Saint-Bruno'}</option><option>{fr ? 'Livraison sur chantier' : 'Jobsite delivery'}</option></select>
      </label>
      <button class="btn" type="submit">{fr ? 'Envoyer ma demande' : 'Send my request'}</button>
      <p class="todo">{fr ? 'Formulaire à brancher (service de formulaires ou workflow d’automatisation des commandes).' : 'Form to connect (form service or order automation workflow).'}</p>
    </form>
    <div>
      <h2>{fr ? 'Ou plus simple encore' : 'Or even simpler'}</h2>
      <p>{fr ? 'Appelez un conseiller technique :' : 'Call a technical advisor:'} <a href={'tel:' + company.phone}><strong>{company.phoneDisplay}</strong></a></p>
      <p>{fr ? 'Écrivez-nous :' : 'Email us:'} <a href={'mailto:' + company.email}>{company.email}</a></p>
      <p class="todo">{fr ? 'À confirmer : numéro pour envoyer une photo par texto, délai de réponse pour une soumission.' : 'To confirm: number to text a photo, quote response time.'}</p>
    </div>
  </div>
</Inner>
